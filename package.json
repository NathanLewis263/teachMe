{
  "name": "teachme",
  "version": "0.1.0",
  "private": true,
  "description": "Screen-aware teaching overlay",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && esbuild src/renderer.tsx --bundle --platform=browser --outfile=dist/renderer.js && tailwindcss -i src/styles.css -o dist/styles.css --minify && cp src/index.html dist/index.html",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
