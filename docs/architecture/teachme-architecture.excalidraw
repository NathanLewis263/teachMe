      "link": null,
      "locked": false,
      "text": "Default model: gpt-6.1-sol\n\nResearch: question only, optional web_search\nLesson: question + previous lesson + research\n             + screenshot only when routed\nCourse: file_search over uploaded course files\nAction check: checkpoint + fresh screenshot\n\nReturns lesson JSON or action check result\nstore: false; timeouts; no automatic retries",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Default model: gpt-6.1-sol\n\nResearch: question only, optional web_search\nLesson: question + previous lesson + research\n             + screenshot only when routed\nCourse: file_search over uploaded course files\nAction check: checkpoint + fresh screenshot\n\nReturns lesson JSON or action check result\nstore: false; timeouts; no automatic retries",
      "autoResize": true,
      "lineHeight": 1.15
    },
